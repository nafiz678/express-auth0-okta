{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Node runs index.ts directly by stripping types, so only erasable syntax is allowed
    "erasableSyntaxOnly": true
  },
  "include": ["index.ts"]
}
